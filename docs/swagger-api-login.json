          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "summary": "PUT /api/usuarios/{id} — Completa el perfil del usuario autenticado (Fase 2 del onboarding).\r\nSolo el propietario de la cuenta puede actualizar su propio perfil; requiere JWT válido.\r\nLos campos de Identity (correo, username, contraseña) son inmutables desde este endpoint.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (string GUID, ruta, requerido) — debe coincidir con el claim `sub` del JWT.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "<b>Apellido</b> (string?, máx. 150) — apellido del usuario.\r\n<b>NumeroCedula</b> (string?, máx. 20) — número de documento de identidad.\r\n<b>FechaNacimiento</b> (DateOnly?) — fecha de nacimiento en formato `YYYY-MM-DD`.\r\n<b>RutaFotoCedula</b> (string?, máx. 500) — ruta o URL de la foto del documento.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletarPerfilRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletarPerfilRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CompletarPerfilRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`UsuarioResponse` con el perfil actualizado."
          },
          "401": {
            "description": "No autenticado (falta o expiró el JWT)."
          },
          "403": {
            "description": "El JWT no corresponde al usuario indicado en la ruta."
          },
          "404": {
            "description": "Usuario no encontrado o anulado."
          }
        }
      },
      "delete": {
        "tags": [
          "Usuarios"
        ],
        "summary": "DELETE /api/usuarios/{id} — Anula (desactiva) un usuario del sistema.\r\nEl usuario queda marcado como `Anulado = true` y no puede iniciar sesión.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (string GUID, ruta, requerido) — identificador del usuario a anular.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario anulado correctamente."
          },
          "404": {
            "description": "No existe un usuario con ese ID."
          }
        }
      }
    },
