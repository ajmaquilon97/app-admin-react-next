      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "POST /api/usuarios — Registra un nuevo usuario en el sistema (Fase 1 del onboarding).\r\nHashea la contraseña con PBKDF2 vía Identity y emite tokens inmediatamente (auto-login).",
        "requestBody": {
          "description": "<b>Nombre</b> (string, máx. 150, requerido) — nombre del usuario.\r\n<b>Email</b> (string email, máx. 200, requerido) — dirección de correo única.\r\n<b>Username</b> (string, máx. 50, requerido) — nombre de usuario único.\r\n<b>Password</b> (string, mín. 6 caracteres, requerido) — contraseña en texto plano (se hashea antes de guardar).\r\n<b>TipoUsuarioId</b> (int, requerido) — ID del tipo de usuario (ver GET /api/usuarios/tipos).",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "201": {
            "description": "{ id, accessToken, refreshToken } — usuario creado y sesión iniciada."
          },
          "409": {
            "description": "Ya existe una cuenta con ese correo o nombre de usuario."
          },
          "400": {
            "description": "Datos inválidos (contraseña muy corta, correo malformado, etc.)."
          }
        }
      }
    },
    "/api/usuarios/{id}": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "GET /api/usuarios/{id} — Obtiene los datos de un usuario por su identificador.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (string GUID, ruta, requerido) — identificador único del usuario.",
