{
  "openapi": "3.0.1",
  "info": {
    "title": "ApiTesis",
    "version": "1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "POST /api/auth/login — Inicia sesión con credenciales locales (correo y contraseña).\r\nDevuelve un access token JWT (15 min) y un refresh token de larga duración.",
        "requestBody": {
          "description": "<b>Email</b> (string, requerido) — correo del usuario registrado.\r\n<b>Password</b> (string, requerido) — contraseña en texto plano; se valida contra el hash almacenado.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ accessToken, refreshToken }"
          },
          "401": {
            "description": "Credenciales inválidas o cuenta anulada."
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "POST /api/auth/refresh — Rota el par de tokens: invalida el refresh token enviado\r\ny emite un access token nuevo junto con un refresh token de reemplazo.",
        "requestBody": {
          "description": "<b>RefreshToken</b> (string, requerido) — token de refresco obtenido en login o en una rotación anterior.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ accessToken, refreshToken } con los tokens renovados."
          },
          "401": {
            "description": "Token inválido, expirado o ya revocado."
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "POST /api/auth/logout — Revoca el refresh token del usuario, cerrando la sesión activa.\r\nTras esta llamada el token queda inutilizable aunque no haya expirado.",
        "requestBody": {
          "description": "<b>RefreshToken</b> (string, requerido) — token de refresco que se desea invalidar.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "204": {
            "description": "Token revocado correctamente (sin cuerpo de respuesta)."
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "GET /api/auth/google — Construye y redirige a la pantalla de consentimiento de Google OAuth.\r\nGenera un parámetro `state` anti-CSRF almacenado en caché (válido 10 min) y lo incluye en la URL de autorización.\r\nNo recibe parámetros del cliente; la configuración proviene de `appsettings / user-secrets`.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirección a accounts.google.com con scope openid, email y profile."
          }
        }
      }
    },
    "/api/auth/google/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "GET /api/auth/google/callback — Callback llamado por Google tras el consentimiento del usuario.\r\nValida el `state` anti-CSRF, intercambia el `code` por los datos del usuario,\r\nrealiza upsert del usuario (vincula login Google si ya existe cuenta local verificada),\r\nemite un par de tokens y redirige al frontend con un código de un solo uso de 60 segundos.\r\nLos tokens NUNCA viajan en la URL.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "<b>code</b> (string, query, inyectado por Google) — authorization code para intercambiar por tokens.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "<b>state</b> (string, query, inyectado por Google) — valor anti-CSRF generado en `GoogleLogin`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "description": "<b>error</b> (string, query, opcional) — presente si el usuario canceló o Google denegó el acceso.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirección al frontend con `?code=<onetimeCode>` o `?error=<motivo>`."
          }
        }
      }
    },
    "/api/auth/google/exchange": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "POST /api/auth/google/exchange — Canjea el código de un solo uso (60 s de vida)\r\ngenerado en el callback de Google por el par definitivo de tokens JWT.\r\nEl código se destruye en el primer uso para evitar reutilización.\r\nDebe llamarse desde el servidor Next.js, nunca desde el navegador.",
        "requestBody": {
          "description": "<b>Code</b> (string, requerido) — código de un solo uso recibido en la URL de redirección del callback.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ accessToken, refreshToken }"
          },
          "401": {
            "description": "Código inválido, expirado o ya utilizado."
          }
        }
      }
    },
    "/api/espacios": {
      "get": {
        "tags": [
          "Espacios"
        ],
        "summary": "GET /api/espacios — Devuelve todos los espacios registrados en el sistema.\r\nNo requiere parámetros.",
        "responses": {
          "200": {
            "description": "Lista de `EspacioResponse` con todos los espacios.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EspacioResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EspacioResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EspacioResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error inesperado al consultar la base de datos."
          }
        }
      },
      "post": {
        "tags": [
          "Espacios"
        ],
        "summary": "POST /api/espacios — Crea un nuevo espacio en el sistema.",
        "requestBody": {
          "description": "<b>Titulo</b> (string) — nombre descriptivo del espacio.\r\n<b>Descripcion</b> (string) — detalle del espacio.\r\n<b>PropietarioId</b> (string GUID) — ID del usuario propietario.\r\n<b>TipoEspacioId</b> (int) — ID del tipo de espacio (catálogo).\r\n<b>Ciudad</b> (string) — ciudad donde se ubica el espacio.\r\n<b>Provincia</b> (string) — provincia del espacio.\r\n<b>LinkUbicacion</b> (string) — URL de Google Maps u otro servicio de ubicación.\r\n<b>Referencia</b> (string) — referencia física o dirección complementaria.\r\n<b>ValidarAforo</b> (bool) — indica si se debe controlar el aforo máximo.\r\n<b>MaxCapacidad</b> (int) — número máximo de personas permitidas.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`EspacioResponse` con los datos del espacio creado.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o error al guardar."
          }
        }
      }
    },
    "/api/espacios/{id}": {
      "get": {
        "tags": [
          "Espacios"
        ],
        "summary": "GET /api/espacios/{id} — Obtiene un espacio específico por su identificador numérico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — identificador único del espacio.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`EspacioResponse` con los datos del espacio.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe un espacio con ese ID."
          }
        }
      },
      "put": {
        "tags": [
          "Espacios"
        ],
        "summary": "PUT /api/espacios/{id} — Actualiza los datos de un espacio existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — identificador del espacio a actualizar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Mismo cuerpo que `POST /api/espacios` con los campos a modificar.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EspacioRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`EspacioResponse` con los datos actualizados.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EspacioResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe un espacio con ese ID."
          }
        }
      },
      "delete": {
        "tags": [
          "Espacios"
        ],
        "summary": "DELETE /api/espacios/{id} — Elimina un espacio del sistema.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — identificador del espacio a eliminar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Espacio eliminado correctamente."
          },
          "404": {
            "description": "No existe un espacio con ese ID."
          }
        }
      }
    },
    "/api/espacios/{espacioId}/reseñas": {
      "get": {
        "tags": [
          "Espacios"
        ],
        "summary": "GET /api/espacios/{espacioId}/reseñas — Lista todas las reseñas de un espacio específico.",
        "parameters": [
          {
            "name": "espacioId",
            "in": "path",
            "description": "<b>espacioId</b> (int, ruta, requerido) — ID del espacio del que se quieren obtener las reseñas.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de `ReseñaResponse`.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReseñaResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReseñaResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReseñaResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error al consultar la base de datos."
          }
        }
      },
      "post": {
        "tags": [
          "Espacios"
        ],
        "summary": "POST /api/espacios/{espacioId}/reseñas — Agrega una nueva reseña a un espacio.",
        "parameters": [
          {
            "name": "espacioId",
            "in": "path",
            "description": "<b>espacioId</b> (int, ruta, requerido) — ID del espacio que se reseña.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "<b>UsuarioId</b> (string GUID) — ID del usuario que escribe la reseña.\r\n<b>Titulo</b> (string) — título corto de la reseña.\r\n<b>Descripcion</b> (string) — texto detallado de la reseña.\r\n<b>Calificacion</b> (int) — puntuación otorgada al espacio.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ReseñaResponse` con los datos de la reseña creada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o error al guardar."
          }
        }
      }
    },
    "/api/espacios/{espacioId}/reseñas/{id}": {
      "put": {
        "tags": [
          "Espacios"
        ],
        "summary": "PUT /api/espacios/{espacioId}/reseñas/{id} — Actualiza el contenido de una reseña existente.",
        "parameters": [
          {
            "name": "espacioId",
            "in": "path",
            "description": "<b>espacioId</b> (int, ruta, requerido) — ID del espacio al que pertenece la reseña.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — ID de la reseña a actualizar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Mismo cuerpo que `POST` reseñas con los campos a modificar.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReseñaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ReseñaResponse` actualizada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReseñaResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe una reseña con ese ID."
          }
        }
      },
      "delete": {
        "tags": [
          "Espacios"
        ],
        "summary": "DELETE /api/espacios/{espacioId}/reseñas/{id} — Anula (elimina) una reseña de un espacio.",
        "parameters": [
          {
            "name": "espacioId",
            "in": "path",
            "description": "<b>espacioId</b> (int, ruta, requerido) — ID del espacio al que pertenece la reseña.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — ID de la reseña a anular.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reseña anulada correctamente."
          },
          "404": {
            "description": "No existe una reseña con ese ID."
          }
        }
      }
    },
    "/api/reservas/{id}": {
      "get": {
        "tags": [
          "Reservas"
        ],
        "summary": "GET /api/reservas/{id} — Obtiene los detalles de una reserva específica.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — identificador único de la reserva.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`ReservaResponse` con los datos de la reserva.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              }
            }
          },
          "404": {
            "description": "No existe una reserva con ese ID."
          }
        }
      },
      "delete": {
        "tags": [
          "Reservas"
        ],
        "summary": "DELETE /api/reservas/{id} — Anula (cancela) una reserva existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "<b>id</b> (int, ruta, requerido) — identificador de la reserva a cancelar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reserva anulada correctamente."
          },
          "404": {
            "description": "No existe una reserva con ese ID."
          }
        }
      }
    },
    "/api/reservas": {
      "post": {
        "tags": [
          "Reservas"
        ],
        "summary": "POST /api/reservas — Crea una nueva reserva para un espacio.",
        "requestBody": {
          "description": "<b>EspacioId</b> (int) — ID del espacio que se desea reservar.\r\n<b>UsuarioId</b> (string GUID) — ID del usuario que realiza la reserva.\r\n<b>FechaInicio</b> (DateTime ISO 8601) — fecha y hora de inicio de la reserva.\r\n<b>FechaFin</b> (DateTime ISO 8601) — fecha y hora de fin de la reserva.\r\n<b>TotalHoras</b> (int) — duración total de la reserva en horas.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReservaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`ReservaResponse` con los datos de la reserva creada.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o conflicto de disponibilidad."
          }
        }
      }
    },
    "/api/tipos-espacios": {
      "get": {
        "tags": [
          "TiposEspacios"
        ],
        "summary": "GET /api/tipos-espacios — Devuelve el catálogo completo de tipos de espacio disponibles.\r\nÚtil para poblar selectores en el formulario de creación o edición de espacios.\r\nNo requiere parámetros.",
        "responses": {
          "200": {
            "description": "Lista de `TiposEspacios` con los campos: id, codigo, nombre.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TiposEspacios"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
